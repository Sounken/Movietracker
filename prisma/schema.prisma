generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String               @id @default(cuid())
  name           String?
  email          String               @unique
  passwordHash   String
  avatarUrl      String?
  bannerUrl      String?
  bio            String?
  /// Échelle d'affichage des notes : 10 (défaut) ou 100. Les notes restent
  /// stockées sur 10 dans UserFilm/UserSeries, seul l'affichage change.
  ratingScale    Int                  @default(10)
  createdAt      DateTime             @default(now())
  films          UserFilm[]
  favoriteFilms  UserFavoriteFilm[]
  lists          UserList[]
  following      UserFollow[]         @relation("follower")
  followers      UserFollow[]         @relation("following")
  series         UserSeries[]
  episodes       UserEpisode[]
  seasons        UserSeason[]
  favoriteSeries UserFavoriteSeries[]
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model UserFavoriteFilm {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId   Int
  position Int

  @@unique([userId, position])
  @@unique([userId, tmdbId])
}

model UserList {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  emoji       String         @default("🎬")
  color       String         @default("#d97742")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  films       UserListFilm[]
}

model UserListFilm {
  id      String   @id @default(cuid())
  listId  String
  list    UserList @relation(fields: [listId], references: [id], onDelete: Cascade)
  tmdbId  Int
  addedAt DateTime @default(now())

  @@unique([listId, tmdbId])
}

// 4 séries préférées épinglées sur le profil (équivalent de UserFavoriteFilm).
model UserFavoriteSeries {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId   Int
  position Int

  @@unique([userId, position])
  @@unique([userId, tmdbId])
}

// Cache local des métadonnées TMDB des séries (équivalent de Film pour les séries TV).
model Series {
  tmdbId           Int      @id
  name             String
  posterUrl        String   @default("")
  year             String   @default("")
  genres           String[]
  voteAverage      Float    @default(0)
  numberOfSeasons  Int      @default(0)
  numberOfEpisodes Int      @default(0)
  updatedAt        DateTime @updatedAt
}

// Rapport d'un utilisateur à une série (note / avis / watchlist / like), au niveau série.
model UserSeries {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId    Int
  rating    Float?
  review    String?
  watchlist Boolean  @default(false)
  liked     Boolean  @default(false)
  watched   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tmdbId])
  @@index([userId, updatedAt])
  @@index([userId, rating])
  @@index([userId, watchlist])
  @@index([tmdbId])
}

// Un épisode vu par un utilisateur (la présence de la ligne = épisode regardé).
model UserEpisode {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seriesId      Int // tmdbId de la série
  seasonNumber  Int
  episodeNumber Int
  runtime       Int?
  watchedAt     DateTime @default(now())

  @@unique([userId, seriesId, seasonNumber, episodeNumber])
  @@index([userId, seriesId])
}

// Note attribuée à une saison précise (indépendante de la note de la série).
// Comme partout, la note est stockée sur 10 ; l'échelle d'affichage est un
// réglage utilisateur.
model UserSeason {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seriesId     Int // tmdbId de la série
  seasonNumber Int
  rating       Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, seriesId, seasonNumber])
  @@index([userId, seriesId])
}

// Cache local des métadonnées TMDB (évite un appel réseau par film à chaque rendu).
model Film {
  tmdbId      Int      @id
  title       String
  posterUrl   String   @default("")
  year        String   @default("")
  genres      String[]
  voteAverage Float    @default(0)
  runtime     Int?
  updatedAt   DateTime @updatedAt
}

model UserFilm {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId    Int
  rating    Float?
  review    String?
  watchlist Boolean   @default(false)
  liked     Boolean   @default(false)
  watched   Boolean   @default(false)
  watchedAt DateTime?
  runtime   Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, tmdbId])
  @@index([userId, updatedAt])
  @@index([userId, rating])
  @@index([userId, watchlist])
  @@index([tmdbId])
  @@index([updatedAt])
}

/// Mesure de performance perçue, envoyée par le navigateur du visiteur.
///
/// GlitchTip couvre les erreurs et les temps de réponse serveur, mais s'arrête
/// aux transactions : il ne remonte pas les Core Web Vitals. Ce modèle comble
/// ce manque sans dépendance ni service supplémentaire — les métriques
/// atterrissent dans la base que l'application utilise déjà.
model WebVital {
  id String @id @default(cuid())

  /// Motif de route et non URL réelle : « /film/[id] » plutôt que
  /// « /film/550 ». Sans cette normalisation, chaque film créerait sa propre
  /// ligne d'agrégat et les moyennes ne voudraient plus rien dire.
  route String

  /// LCP, INP, CLS, TTFB, FCP.
  metric String

  /// Millisecondes, sauf pour CLS qui est un score sans unité.
  value Float

  /// Verdict du seuil, calculé par la bibliothèque : good, needs-improvement, poor.
  rating String

  /// « navigate », « reload », « back-forward », « prerender ». Une navigation
  /// arrière profite du cache et n'est pas comparable à une visite initiale.
  navigationType String?

  /// Renseigné pour les visiteurs identifiés, nul sinon. Aucune donnée
  /// personnelle n'est stockée au-delà de cette référence.
  userId String?

  createdAt DateTime @default(now())

  /// L'index porte la requête d'agrégation : percentile par route et par
  /// métrique sur une fenêtre de temps.
  @@index([metric, route, createdAt])
  @@index([createdAt])
}
