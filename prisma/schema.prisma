generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String              @id @default(cuid())
  name           String?
  email          String              @unique
  passwordHash   String
  avatarUrl      String?
  bannerUrl      String?
  bio            String?
  createdAt      DateTime            @default(now())
  films          UserFilm[]
  favoriteFilms  UserFavoriteFilm[]
  lists          UserList[]
  following      UserFollow[]        @relation("follower")
  followers      UserFollow[]        @relation("following")
  series         UserSeries[]
  episodes       UserEpisode[]
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model UserFavoriteFilm {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId   Int
  position Int

  @@unique([userId, position])
  @@unique([userId, tmdbId])
}

model UserList {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  emoji       String         @default("🎬")
  color       String         @default("#d97742")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  films       UserListFilm[]
}

model UserListFilm {
  id      String   @id @default(cuid())
  listId  String
  list    UserList @relation(fields: [listId], references: [id], onDelete: Cascade)
  tmdbId  Int
  addedAt DateTime @default(now())

  @@unique([listId, tmdbId])
}

// Cache local des métadonnées TMDB des séries (équivalent de Film pour les séries TV).
model Series {
  tmdbId           Int      @id
  name             String
  posterUrl        String   @default("")
  year             String   @default("")
  genres           String[]
  voteAverage      Float    @default(0)
  numberOfSeasons  Int      @default(0)
  numberOfEpisodes Int      @default(0)
  updatedAt        DateTime @updatedAt
}

// Rapport d'un utilisateur à une série (note / avis / watchlist / like), au niveau série.
model UserSeries {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId    Int
  rating    Float?
  review    String?
  watchlist Boolean   @default(false)
  liked     Boolean   @default(false)
  watched   Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, tmdbId])
  @@index([userId, updatedAt])
  @@index([userId, rating])
  @@index([userId, watchlist])
  @@index([tmdbId])
}

// Un épisode vu par un utilisateur (la présence de la ligne = épisode regardé).
model UserEpisode {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seriesId      Int // tmdbId de la série
  seasonNumber  Int
  episodeNumber Int
  runtime       Int?
  watchedAt     DateTime @default(now())

  @@unique([userId, seriesId, seasonNumber, episodeNumber])
  @@index([userId, seriesId])
}

// Cache local des métadonnées TMDB (évite un appel réseau par film à chaque rendu).
model Film {
  tmdbId      Int      @id
  title       String
  posterUrl   String   @default("")
  year        String   @default("")
  genres      String[]
  voteAverage Float    @default(0)
  runtime     Int?
  updatedAt   DateTime @updatedAt
}

model UserFilm {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId    Int
  rating    Float?
  review    String?
  watchlist Boolean   @default(false)
  liked     Boolean   @default(false)
  watched   Boolean   @default(false)
  watchedAt DateTime?
  runtime   Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, tmdbId])
  @@index([userId, updatedAt])
  @@index([userId, rating])
  @@index([userId, watchlist])
  @@index([tmdbId])
  @@index([updatedAt])
}
