generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String               @id @default(cuid())
  name           String?
  email          String               @unique
  passwordHash   String
  avatarUrl      String?
  bannerUrl      String?
  bio            String?
  /// Échelle d'affichage des notes : 10 (défaut) ou 100. Les notes restent
  /// stockées sur 10 dans UserFilm/UserSeries, seul l'affichage change.
  ratingScale    Int                  @default(10)
  /// Plateformes auxquelles l'utilisateur est abonné (identifiants TMDB de
  /// `WATCH_PROVIDERS`). Sert au raccourci « Mes plateformes » de Découvrir
  /// et à signaler, sur les fiches, ce qui est inclus dans ses abonnements.
  watchProviders Int[]                @default([])
  /// Incrémenté à chaque réinitialisation du mot de passe. Chaque session
  /// emporte la valeur du moment : une session plus ancienne n'est plus
  /// reconnue, ce qui déconnecte tous les appareils d'un coup.
  sessionVersion Int                  @default(0)
  createdAt      DateTime             @default(now())
  films          UserFilm[]
  favoriteFilms  UserFavoriteFilm[]
  lists          UserList[]
  following      UserFollow[]         @relation("follower")
  followers      UserFollow[]         @relation("following")
  series         UserSeries[]
  episodes       UserEpisode[]
  seasons        UserSeason[]
  favoriteSeries UserFavoriteSeries[]
  notifications  Notification[]       @relation("notificationRecipient")
  actedOn        Notification[]       @relation("notificationActor")
  puzzlePlays    PuzzlePlay[]
  passwordResets PasswordResetToken[]
  filmWatches    FilmWatch[]
  activities     Activity[]
  reactions      ActivityReaction[]
  reminders      ReleaseReminder[]
}

/// Lien de réinitialisation du mot de passe, à usage unique.
///
/// Seule l'empreinte SHA-256 du jeton est conservée : une fuite de la base ne
/// donne aucun lien utilisable. Les jetons d'un compte sont tous supprimés dès
/// qu'une réinitialisation aboutit.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Notification reçue par un utilisateur.
///
/// Créée aujourd'hui pour un seul cas — quelqu'un s'abonne à vous — mais le
/// champ `type` laisse la place aux suivants (avis d'un ami, réciprocité)
/// sans nouvelle migration.
model Notification {
  id        String    @id @default(cuid())
  /// Destinataire.
  userId    String
  user      User      @relation("notificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  /// Auteur de l'action à l'origine de la notification ; nul pour celles
  /// qu'envoie l'application elle-même (sortie, épisode, disponibilité).
  actorId    String?
  actor      User?     @relation("notificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  /// « follow », « reaction », « release », « episode » ou « available ».
  type       String
  /// Œuvre concernée par une notification de l'application, et son titre au
  /// moment de l'envoi (le texte ne dépend pas d'un appel TMDB à l'affichage).
  media      String?
  tmdbId     Int?
  title      String?
  /// Précision affichée : « S02E05 », « au cinéma », « sur Netflix »…
  detail     String?
  /// Empêche d'envoyer deux fois la même notification de l'application quand
  /// la tâche quotidienne repasse (« episode:1396:2:5:<userId> »).
  dedupeKey  String?   @unique
  /// Réaction : l'activité concernée et l'emoji choisi. Une seule ligne par
  /// auteur (contrainte ci-dessous) : elle désigne sa dernière réaction.
  activityId String?
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  emoji      String?
  /// Nul tant que la notification n'a pas été vue.
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  /// Se désabonner puis se réabonner ne doit pas empiler les notifications :
  /// la ligne existante est réutilisée et redevient non lue.
  @@unique([userId, actorId, type])
  @@index([userId, createdAt])
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model UserFavoriteFilm {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId   Int
  position Int

  @@unique([userId, position])
  @@unique([userId, tmdbId])
}

model UserList {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  emoji       String         @default("🎬")
  color       String         @default("#d97742")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  films       UserListFilm[]
}

model UserListFilm {
  id      String   @id @default(cuid())
  listId  String
  list    UserList @relation(fields: [listId], references: [id], onDelete: Cascade)
  tmdbId  Int
  addedAt DateTime @default(now())

  @@unique([listId, tmdbId])
}

// 4 séries préférées épinglées sur le profil (équivalent de UserFavoriteFilm).
model UserFavoriteSeries {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId   Int
  position Int

  @@unique([userId, position])
  @@unique([userId, tmdbId])
}

// Cache local des métadonnées TMDB des séries (équivalent de Film pour les séries TV).
model Series {
  tmdbId           Int      @id
  name             String
  posterUrl        String   @default("")
  year             String   @default("")
  genres           String[]
  voteAverage      Float    @default(0)
  numberOfSeasons  Int      @default(0)
  numberOfEpisodes Int      @default(0)
  updatedAt        DateTime @updatedAt
}

// Rapport d'un utilisateur à une série (note / avis / watchlist / like), au niveau série.
model UserSeries {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId    Int
  rating    Float?
  review    String?
  watchlist Boolean  @default(false)
  liked     Boolean  @default(false)
  watched   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tmdbId])
  @@index([userId, updatedAt])
  @@index([userId, rating])
  @@index([userId, watchlist])
  @@index([tmdbId])
}

// Un épisode vu par un utilisateur (la présence de la ligne = épisode regardé).
model UserEpisode {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seriesId      Int // tmdbId de la série
  seasonNumber  Int
  episodeNumber Int
  runtime       Int?
  watchedAt     DateTime @default(now())

  @@unique([userId, seriesId, seasonNumber, episodeNumber])
  @@index([userId, seriesId])
}

// Note attribuée à une saison précise (indépendante de la note de la série).
// Comme partout, la note est stockée sur 10 ; l'échelle d'affichage est un
// réglage utilisateur.
model UserSeason {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seriesId     Int // tmdbId de la série
  seasonNumber Int
  rating       Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, seriesId, seasonNumber])
  @@index([userId, seriesId])
}

// Cache local des métadonnées TMDB (évite un appel réseau par film à chaque rendu).
model Film {
  tmdbId      Int      @id
  title       String
  posterUrl   String   @default("")
  year        String   @default("")
  genres      String[]
  voteAverage Float    @default(0)
  runtime     Int?
  updatedAt   DateTime @updatedAt
}

model UserFilm {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId    Int
  rating    Float?
  review    String?
  watchlist Boolean   @default(false)
  liked     Boolean   @default(false)
  watched   Boolean   @default(false)
  watchedAt DateTime?
  runtime   Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, tmdbId])
  @@index([userId, updatedAt])
  @@index([userId, rating])
  @@index([userId, watchlist])
  @@index([tmdbId])
  @@index([updatedAt])
}

/// Un visionnage daté d'un film : une ligne du journal.
///
/// Un film vu trois fois a trois lignes. La note reste unique et vit dans
/// UserFilm ; `UserFilm.watchedAt` suit le visionnage le plus récent. Un film
/// marqué vu sans date (noté depuis sa fiche, par exemple) n'a pas de ligne :
/// il est dans la collection, pas dans le journal.
model FilmWatch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId    Int
  /// Jour du visionnage, à minuit UTC (saisi comme une date, sans heure).
  watchedAt DateTime
  /// Remarque facultative (« au cinéma », « avec Léa »…).
  note      String?
  createdAt DateTime @default(now())
  activity  Activity?

  @@index([userId, watchedAt])
  @@index([userId, tmdbId])
}

/// Un événement du fil d'activité : une note, un visionnage, un revisionnage.
///
/// Noter un film puis le dater dans le journal le même jour produit une seule
/// activité (« a vu X — ★ 8 »), pas deux : une action récente sur la même
/// œuvre est complétée plutôt que doublée (cf. lib/activity.ts).
model Activity {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// « movie » ou « tv ».
  media         String
  tmdbId        Int
  /// « rated », « watched » ou « rewatched ».
  kind          String
  /// Note et avis au moment de l'activité (sur 10).
  rating        Float?
  review        String?
  /// Visionnage du journal à l'origine de l'activité, le cas échéant.
  filmWatchId   String?            @unique
  filmWatch     FilmWatch?         @relation(fields: [filmWatchId], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  reactions     ActivityReaction[]
  notifications Notification[]

  @@index([userId, media, createdAt])
  @@index([userId, media, tmdbId])
}

/// Réaction emoji d'un utilisateur à une activité. Plusieurs emojis possibles
/// par personne, chacun une fois.
model ActivityReaction {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji      String
  createdAt  DateTime @default(now())

  @@unique([activityId, userId, emoji])
}

/// « Me prévenir » : l'utilisateur veut être notifié de la sortie française
/// d'un film (en salles, ou en numérique s'il n'y passe pas).
model ReleaseReminder {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId     Int
  createdAt  DateTime  @default(now())
  /// Renseigné quand la notification de sortie est partie.
  notifiedAt DateTime?

  @@unique([userId, tmdbId])
  @@index([notifiedAt])
}

/// Mesure de performance perçue, envoyée par le navigateur du visiteur.
///
/// GlitchTip couvre les erreurs et les temps de réponse serveur, mais s'arrête
/// aux transactions : il ne remonte pas les Core Web Vitals. Ce modèle comble
/// ce manque sans dépendance ni service supplémentaire — les métriques
/// atterrissent dans la base que l'application utilise déjà.
model WebVital {
  id String @id @default(cuid())

  /// Motif de route et non URL réelle : « /film/[id] » plutôt que
  /// « /film/550 ». Sans cette normalisation, chaque film créerait sa propre
  /// ligne d'agrégat et les moyennes ne voudraient plus rien dire.
  route String

  /// LCP, INP, CLS, TTFB, FCP.
  metric String

  /// Millisecondes, sauf pour CLS qui est un score sans unité.
  value Float

  /// Verdict du seuil, calculé par la bibliothèque : good, needs-improvement, poor.
  rating String

  /// « navigate », « reload », « back-forward », « prerender ». Une navigation
  /// arrière profite du cache et n'est pas comparable à une visite initiale.
  navigationType String?

  /// Renseigné pour les visiteurs identifiés, nul sinon. Aucune donnée
  /// personnelle n'est stockée au-delà de cette référence.
  userId String?

  createdAt DateTime @default(now())

  /// L'index porte la requête d'agrégation : percentile par route et par
  /// métrique sur une fenêtre de temps.
  @@index([metric, route, createdAt])
  @@index([createdAt])
}

/// Vivier du Moviedle : titres assez connus pour être devinables, films et
/// séries confondus. Les attributs sont **figés au remplissage** — sans cette
/// copie, chaque proposition d'un joueur coûterait un appel TMDB.
///
/// Rempli par `scripts/build-puzzle-pool.ts`, à relancer de temps en temps :
/// le vivier n'a pas à être frais, seulement stable.
model PuzzleEntry {
  id          String   @id @default(cuid())
  /// "movie" ou "tv" : les deux jeux partagent tables et logique.
  media       String
  tmdbId      Int
  title       String
  posterUrl   String   @default("")
  /// Sortie (film) ou première diffusion (série).
  year        Int
  genres      String[]
  countries   String[]
  /// Trois premiers noms au générique.
  actors      String[]
  /// Réalisateur (film) ou créateur (série) — plusieurs possibles.
  authors     String[]
  /// Films seulement : durée en minutes.
  runtime     Int?
  /// Séries seulement : nombre de saisons.
  seasons     Int?
  /// Séries seulement : chaîne ou plateforme d'origine.
  network     String?
  /// Films seulement : saga (`belongs_to_collection`).
  collection  String?
  voteAverage Float
  voteCount   Int
  updatedAt   DateTime @updatedAt

  @@unique([media, tmdbId])
  @@index([media])
  /// Autocomplétion : on cherche par titre dans un seul média.
  @@index([media, title])
}

/// Réponse du jour, figée à la première consultation. Sans cette table, un
/// tirage calculé à la volée changerait à chaque redéploiement — les caches
/// applicatifs étant vidés à chaque fois (cf. G8).
model DailyPuzzle {
  id        String   @id @default(cuid())
  media     String
  /// Jour au fuseau Europe/Paris, `AAAA-MM-JJ`.
  day       String
  tmdbId    Int
  createdAt DateTime @default(now())

  @@unique([media, day])
}

/// Partie d'un joueur, un enregistrement par jour et par média.
model PuzzlePlay {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  media     String
  day       String
  /// Identifiants TMDB proposés, dans l'ordre de jeu.
  guesses   Int[]
  solved    Boolean   @default(false)
  solvedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, media, day])
  /// Série de victoires : on remonte les parties d'un joueur par jour.
  @@index([userId, media, day])
}
